# SovereignLink – Environment variable reference
# Copy this file to .env.development for local dev, or set these in your
# Netlify/deployment environment for production.
# Never commit .env.development or .env.local to git.

# ----- IPFS -----
# Local Kubo dev node (see README.md "Local IPFS Setup"):
#   PUBLIC_IPFS_API=http://127.0.0.1:5001
#   PUBLIC_IPFS_GATEWAY=http://127.0.0.1:8080
#
# Production (public gateway – CORS restricted on localhost):
#   PUBLIC_IPFS_API=https://ipfs.io
#   PUBLIC_IPFS_GATEWAY=https://ipfs.io
#
# Authenticated Pinata (durable, CORS-safe from browser):
#   PUBLIC_IPFS_API=https://api.pinata.cloud
#   PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud
PUBLIC_IPFS_API=https://ipfs.io
PUBLIC_IPFS_GATEWAY=https://ipfs.io

# ----- Midnight / Cardano environment -----
# Options: local-devnet | testnet | mainnet
PUBLIC_MIDNIGHT_ENV=local-devnet
